# OPTIONAL overrides for CI/EAS or local work. Normal setup is in config/app.js;
# no .env file is required. Nonempty environment values override the selected variant.
# EAS profiles already select APP_VARIANT. Leave this blank to use config/app.js.
APP_VARIANT=

# Overrides variants.<variant>.apiUrl (no trailing /api).
# When supplied, production requires HTTPS; local development may use HTTP.
EXPO_PUBLIC_API_URL=

# Overrides variants.<variant>.googleAuth public client IDs.
# Web client ID is the audience verified by the API. Never put a client secret in the app.
# iOS client must match the resolved bundle identifier (including .dev or .preview).
# Setting/changing the iOS ID requires a new native build for its reversed URL scheme.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Overrides variants.<variant>.googleMaps native SDK keys.
# Restrict each key to this build's Android package + signing SHA-1 or iOS bundle ID.
# Changing a key requires a new native development build.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
