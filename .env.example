# Default local/build brand: neutral UX wireframe template, with its own native identity.
APP_BRAND=template
APP_VARIANT=development

# Optional Identity API origin (no trailing /api); retained services need it, the catalog does not.
# When supplied, production requires HTTPS; local development may use HTTP.
EXPO_PUBLIC_API_URL=

# Google Maps native SDK keys. Enable the matching Maps SDK in Google Cloud.
# Restrict each key to this build's Android package + signing SHA-1 or iOS bundle ID.
# Changing a key requires a new native development build.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
