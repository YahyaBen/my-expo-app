# Default local/build brand: neutral UX wireframe template, with its own native identity.
APP_BRAND=template
APP_VARIANT=development

# Optional Android Maps key restricted to the selected brand's Android package.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional Identity API origin (no trailing /api); retained services need it, the catalog does not.
# When supplied, production requires HTTPS; local development may use HTTP.
EXPO_PUBLIC_API_URL=

# npm start opens Storybook in a development build. npm run start:app shows the wireframe.
# Preview and production EAS profiles disable Storybook; __DEV__ also guards release code.
EXPO_PUBLIC_STORYBOOK_ENABLED=true
