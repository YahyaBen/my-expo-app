# Default local/build brand: neutral UX wireframe template, with its own native identity.
APP_BRAND=template
APP_VARIANT=development

# Optional Android Maps key restricted to the selected brand's Android package.
GOOGLE_MAPS_ANDROID_API_KEY=

# Identity API origin reachable from your iOS/Android device (no trailing /api).
# Production requires HTTPS; local development may use HTTP.
EXPO_PUBLIC_API_URL=

# Expose the native component catalog in this bundle (Home/Settings and direct URLs).
EXPO_PUBLIC_ENABLE_DEV_SCREENS=true

# Development-only Storybook route. npm run storybook:dev opts into both preview flags.
EXPO_PUBLIC_STORYBOOK_ENABLED=false
