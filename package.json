{
  "name": "hyrkul-template",
  "version": "1.0.3",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "start": "node scripts/start.cjs",
    "start:app": "node scripts/start.cjs --app",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "storybook:dev": "node scripts/start.cjs",
    "storybook:generate": "sb-rn-get-stories",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint . --max-warnings=0",
    "lint:staged": "lint-staged",
    "format": "prettier --write src config docs .agents .github .husky .rnstorybook scripts \"*.{js,cjs,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check src config docs .agents .github .husky .rnstorybook scripts \"*.{js,cjs,mjs,json,md,yaml,yml}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@hookform/resolvers": "^5.9.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "npm:react-native-skia@2.15.2",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-awesome-app-icon": "2.2.1",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-in-app-updates": "0.13.0",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-observe": "~58.0.18",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "i18next": "^26.5.11",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.7.0",
    "@storybook/addon-ondevice-controls": "10.7.0",
    "@storybook/react-native": "10.7.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "storybook": "10.6.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/ui": "$@expo/ui",
    "react-native-safe-area-context": "$react-native-safe-area-context",
    "@storybook/react": "10.6.5",
    "@storybook/react-native-ui": "10.7.0",
    "@storybook/react-native-ui-common": "10.7.0",
    "@storybook/react-native-theming": "10.7.0",
    "@storybook/react-dom-shim": "10.6.5",
    "@storybook/mcp": {
      "valibot": "^1.5.0"
    },
    "xcode": {
      "uuid": "^11.1.1"
    },
    "esbuild": "~0.26.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    }
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  }
}
