{
  "name": "my-app-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~58.0.24",
    "@hookform/resolvers": "^5.9.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-firebase/app": "^26.4.1",
    "@react-native-firebase/messaging": "^26.4.1",
    "@shopify/flash-list": "2.3.2",
    "@shopify/react-native-skia": "npm:react-native-skia@2.15.2",
    "@stepperize/react": "^7.0.0",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "expo": "~58.0.20",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.13",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-image-picker": "~58.0.10",
    "expo-in-app-updates": "0.13.0",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-observe": "~58.0.16",
    "expo-router": "~58.0.27",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.7",
    "i18next": "^26.5.11",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.7.0",
    "@storybook/addon-ondevice-controls": "10.7.0",
    "@storybook/react-native": "10.7.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "expo-build-properties": "~58.0.11",
    "expo-dev-client": "~58.0.16",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "storybook": "10.6.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/ui": "$@expo/ui",
    "react-native-safe-area-context": "$react-native-safe-area-context",
    "@storybook/react": "10.6.5",
    "@storybook/react-native-ui": "10.7.0",
    "@storybook/react-native-ui-common": "10.7.0",
    "@storybook/react-native-theming": "10.7.0",
    "@storybook/react-dom-shim": "10.6.5",
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "@storybook/mcp": {
      "valibot": "^1.5.0"
    },
    "xcode": {
      "uuid": "^11.1.1"
    },
    "esbuild": "~0.26.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "storybook:dev": "node .rnstorybook/start.cjs",
    "storybook:generate": "sb-rn-get-stories",
    "lint": "expo lint . --max-warnings=0",
    "lint:staged": "lint-staged",
    "prepare": "node .husky/install.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src config docs .agents .github .husky .rnstorybook \"*.{js,cjs,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check src config docs .agents .github .husky .rnstorybook \"*.{js,cjs,mjs,json,md,yaml,yml}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml,css,scss,html}": "prettier --write"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@shopify/react-native-skia"
      ]
    },
    "autolinking": {
      "ios": {
        "exclude": [
          "@react-native-firebase/app",
          "@react-native-firebase/messaging",
          "expo-in-app-updates"
        ]
      }
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.3.0 || >=26.0.0"
  }
}
