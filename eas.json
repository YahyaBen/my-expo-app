{
  "cli": {
    "version": ">= 24.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "APP_BRAND": "template",
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "true"
      },
      "android": {
        "gradleCommand": ":app:assembleDebug --max-workers=1 --no-parallel --init-script ../config/android-build-memory.gradle"
      },
      "ios": {
        "image": "auto",
        "simulator": true
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "ios": {
        "image": "auto"
      },
      "env": {
        "APP_BRAND": "template",
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "false"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "ios": {
        "image": "auto"
      },
      "env": {
        "APP_BRAND": "template",
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_STORYBOOK_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
