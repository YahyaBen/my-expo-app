{
  "expo": {
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./config/locales/en.json",
      "fr": "./config/locales/fr.json",
      "ar": "./config/locales/ar.json"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-build-properties",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos when you use the camera.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to record audio when you use video recording.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to select a photo from your library.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos when you use the camera.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to record audio when you use video recording."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to show your current location in Settings.",
          "locationAlwaysPermission": "Allow $(PRODUCT_NAME) to use your location.",
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location.",
          "motionUsagePermission": "Allow $(PRODUCT_NAME) to detect your current motion activity.",
          "locationFullAccuracyPermission": "Allow $(PRODUCT_NAME) to access your precise location."
        }
      ],
      "@react-native-community/datetimepicker",
      "./config/with-android-permissions"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
